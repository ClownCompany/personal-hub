# Used by docker-compose.dev.yml (local PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_hub
POSTGRES_PORT=5432

# Duplicates the user, password and port above; keep them in sync.
# URL-encode special characters in the password.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_hub

# Integration tests only; the database is created automatically on the same server.
# Must differ from DATABASE_URL, use a local host, and end in _test (letters, digits, underscores).
# Query parameters other than sslmode are rejected. Keep user, password and port in sync with POSTGRES_*.
# User and port must be explicit; PG* environment variables (PGPORT, PGUSER, ...) are not supported here.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_hub_test
